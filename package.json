{
  "name": "commentor-dementor",
  "displayName": "commentor-dementor",
  "description": "Folds long comments until you hover over or edit them",
  "version": "0.1.2",
  "publisher": "dmccloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmccloud/commentor-dementor.git"
  },
  "bugs": {
    "url": "https://github.com/dmccloud/commentor-dementor/issues"
  },
  "homepage": "https://github.com/dmccloud/commentor-dementor#readme",
  "icon": "images/commentor-dementor-icon-friendly-256.png",
  "keywords": [
    "comments",
    "comment folding",
    "folding",
    "readability",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commentor-dementor.refresh",
        "title": "Commentor Dementor: Refresh Folded Comments"
      }
    ],
    "configuration": {
      "title": "Commentor Dementor",
      "properties": {
        "commentorDementor.previewLength": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "description": "Number of comment characters to show before folding the remainder."
        },
        "commentorDementor.consecutiveLineCommentThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "Number of consecutive standalone single-line comments required before they collapse as one group."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.74.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
